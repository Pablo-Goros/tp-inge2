# Copiar a `.env` SOLO si querés cambiar algo. Sin `.env`, compose.yaml usa estos mismos valores de demo.
# En la VM: crear `.env` con secretos propios. Nunca commitear `.env` ni credenciales reales.
# Referencia: docs/contracts.md §1.

# --- Secretos (cambiar en cloud) ---
POSTGRES_USER=certs
POSTGRES_PASSWORD=certs
POSTGRES_DB=certs
RABBITMQ_USER=certs
RABBITMQ_PASSWORD=certs
# Obligatorio, mínimo 32 bytes. En cloud: generar con `openssl rand -hex 32`.
JWT_SECRET=demo-jwt-secret-solo-local-cambiar-en-cloud
# Contraseña de operador@demo.test y alumno01..25@demo.test (la siembra init).
DEMO_PASSWORD=demo1234

# --- Aplicación ---
# Base de la URL del QR. En la VM: http://<IP-publica>:8080 ANTES de emitir cualquier certificado.
PUBLIC_BASE_URL=http://localhost:8080
# Solo simulated está implementado; chain queda como tarea extra fuera de esta entrega.
REGISTRY_BACKEND=simulated
# Intentos totales, incluido el primero; mínimo 1.
MAX_ATTEMPTS=3
# Cambiarlo con el broker ya inicializado exige recrear la cola cert.issue.wait.
RETRY_DELAY_SECONDS=5
POLL_INTERVAL_SECONDS=1.0
INIT_TIMEOUT_SECONDS=60
BCRYPT_ROUNDS=12

# --- Demo de fallas (docs/contracts.md §8) ---
# Ejemplos: transient:2   ·   permanent:alumno03@demo.test   ·   ambos separados por coma
# transient cuenta ejecuciones globales del proceso; se reinicia al recrear el worker.
FAULT_INJECTION=

# DATABASE_URL y RABBITMQ_URL se arman en compose.yaml a partir de los valores de arriba.
